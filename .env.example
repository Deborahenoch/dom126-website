# ============================================================
# DOM126 Fragrances — environment configuration
# Copy to `.env.local` to override any value. NEVER commit real
# credentials or API keys to Git.
#
# The official site URL and WhatsApp number are already configured
# with their live values in src/lib/site-config.ts:
#   - https://dom126fragrance.store
#   - WhatsApp: +234 912 916 8474
# The variables below exist purely to override them if ever needed.
# ============================================================

# Canonical public URL of the website (SEO metadata & sitemap)
NEXT_PUBLIC_SITE_URL="https://dom126fragrance.store"

# Official DOM126 WhatsApp number for ordering, international format, digits only
NEXT_PUBLIC_WHATSAPP_NUMBER="2349129168474"

# Public contact email (shown on the Contact page). Leave empty until confirmed.
NEXT_PUBLIC_CONTACT_EMAIL=""

# Google Analytics 4 measurement ID (e.g. "G-XXXXXXXXXX"). Analytics stays
# disabled until this is set.
NEXT_PUBLIC_GA_ID=""

# Meta Pixel ID. Pixel stays disabled until this is set.
NEXT_PUBLIC_META_PIXEL_ID=""
