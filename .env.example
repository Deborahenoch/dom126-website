# ============================================================
# DOM126 Fragrances — environment configuration
# Copy to `.env.local` and fill in real values.
# NEVER commit real credentials to Git.
# ============================================================

# Canonical public URL of the website (used for SEO metadata & sitemap)
NEXT_PUBLIC_SITE_URL=""

# Official DOM126 WhatsApp number for ordering, international format, digits only.
# Example: NEXT_PUBLIC_WHATSAPP_NUMBER="2348012345678"
# Until this is set, WhatsApp ordering surfaces are shown as "coming soon".
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# Public contact email (shown on the Contact page). Leave empty until confirmed.
NEXT_PUBLIC_CONTACT_EMAIL=""

# Google Analytics 4 measurement ID (e.g. "G-XXXXXXXXXX"). Analytics stays
# disabled until this is set.
NEXT_PUBLIC_GA_ID=""

# Meta Pixel ID. Pixel stays disabled until this is set.
NEXT_PUBLIC_META_PIXEL_ID=""
